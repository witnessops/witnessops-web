{
  "name": "witnessops-web-workspace",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0 <23",
    "pnpm": "9.15.4"
  },
  "scripts": {
    "dev": "pnpm --filter witnessops-web dev",
    "build": "pnpm --filter witnessops-web build",
    "lint": "pnpm --filter witnessops-web lint",
    "typecheck": "pnpm --filter witnessops-web typecheck",
    "test": "pnpm --filter witnessops-web test && pnpm --filter @witnessops/proof test && pnpm ticket-triage:test && pnpm route-parity && pnpm receipt-smoke && pnpm smoke:buyer-path:test && pnpm verify:public-seo:test && pnpm deploy:aws:test",
    "health": "pnpm --filter witnessops-web build && pnpm --filter witnessops-web lint && pnpm --filter witnessops-web typecheck && pnpm ticket-triage:typecheck && pnpm test && pnpm docs:validate && pnpm signals:validate",
    "health:node22": "bash scripts/health-on-node22.sh",
    "health:node22:goal0": "bash scripts/health-on-node22-goal0.sh",
    "release": "pnpm --filter witnessops-web build",
    "ui-proof:hero": "pnpm --filter witnessops-web build && playwright test homepage-hero.spec.ts",
    "ui-proof:hero:ci": "playwright test homepage-hero.spec.ts",
    "ui-proof:open": "playwright show-report artifacts/ui-proof/playwright-report",
    "proof:test": "pnpm --filter @witnessops/proof test",
    "optimize:quick-check": "bash .grok/skills/optimize-witnessops-web/scripts/quick-check.sh",
    "route-parity": "node --import tsx --test tests/route-parity/route-parity.test.ts",
    "receipt-smoke": "node --import tsx --test tests/receipt-smoke/receipt-smoke.test.ts",
    "smoke:buyer-path": "node --import tsx ./scripts/smoke-buyer-path.ts",
    "smoke:buyer-path:local": "node --import tsx ./scripts/smoke-buyer-path.ts --base-url http://127.0.0.1:3001",
    "smoke:buyer-path:test": "node --import tsx --test tests/public-smoke/smoke-buyer-path.test.ts",
    "verify:public-seo": "node --import tsx ./scripts/verify-public-seo.ts",
    "verify:public-seo:test": "node --import tsx --test scripts/verify-public-seo-xml.test.ts",
    "docs:validate": "node --import tsx ./scripts/validate-docs.ts",
    "signals:validate": "node --import tsx ./scripts/validate-signals.ts",
    "ticket-triage:typecheck": "pnpm --filter @witnessops/ticket-triage-demo typecheck",
    "ticket-triage:test": "pnpm --filter @witnessops/ticket-triage-demo test",
    "ticket-triage:acceptance:mock": "pnpm --filter @witnessops/ticket-triage-demo acceptance:mock",
    "ticket-triage:acceptance:live": "pnpm --filter @witnessops/ticket-triage-demo acceptance:live",
    "deploy:k3s:build": "node deploy/scripts/retired-production-deploy.mjs",
    "deploy:k3s:prod": "node deploy/scripts/retired-production-deploy.mjs",
    "deploy:k3s:dev": "bash deploy/scripts/k3s-deploy-dev.sh",
    "deploy:k3s:both": "node deploy/scripts/retired-production-deploy.mjs",
    "deploy:k3s:smoke": "bash deploy/scripts/smoke-prod-dev.sh",
    "deploy:k3s:status": "bash deploy/scripts/k3s-status.sh",
    "deploy:k3s:status:topology": "node deploy/scripts/run-status-with-topology.mjs",
    "deploy:k3s:validate-topology": "node deploy/scripts/run-status-with-topology.mjs --validate-only",
    "deploy:k3s:test-topology": "node --test deploy/scripts/run-status-with-topology.test.mjs",
    "deploy:k3s:test-state-aggregate": "python3 -m unittest discover -s deploy/scripts -p 'test_witnessops_live_state_aggregate_v1.py'",
    "deploy:k3s:test-evidence": "pnpm deploy:k3s:test-topology && pnpm deploy:k3s:test-state-aggregate",
    "deploy:k3s:dev:teardown": "bash deploy/scripts/k3s-dev-teardown.sh",
    "deploy:k3s:test-parity": "bash deploy/scripts/test-k3s-parity.sh",
    "deploy:k3s:hygiene": "bash deploy/scripts/k3s-disk-hygiene.sh",
    "deploy:aws:test": "node --test deploy/aws/validate-github-deployment.test.mjs deploy/aws/validate-acceptance.test.mjs deploy/scripts/retired-production-deploy.test.mjs && bash -n deploy/aws/candidate-acceptance.sh",
    "deploy:aws:validate": "node deploy/aws/validate-acceptance.mjs",
    "deploy:aws:validate-github": "node deploy/aws/validate-github-deployment.mjs",
    "deploy:aws:candidate": "bash deploy/aws/candidate-acceptance.sh"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.59.1",
    "eslint": "^9.22.0",
    "eslint-config-next": "15.5.21",
    "tsx": "^4.22.4",
    "turbo": "^2.9.14",
    "typescript": "^5.7.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "flatted": ">=3.4.2",
      "hono": "4.12.34",
      "express-rate-limit": "8.2.2",
      "ip-address": "10.3.1",
      "picomatch": ">=4.0.4",
      "brace-expansion@1": "1.1.16",
      "brace-expansion@5": "5.0.7",
      "nanoid": "3.3.18",
      "sharp": ">=0.35.0"
    }
  }
}
