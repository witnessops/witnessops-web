{
  "name": "witnessops-web",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\" && next build",
    "start": "next start",
    "start:ui-proof": "next start --hostname 127.0.0.1 --port 3001",
    "validate:ask-authority-loader": "node ./scripts/validate-ask-authority-loader-standalone.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "NODE_ENV=test TSX_TSCONFIG_PATH=tsconfig.test.json node --import ./scripts/register-server-only-test-stub.mjs --import tsx --test 'src/**/*.test.ts' 'src/**/*.test.tsx'",
    "test:evidence": "tsx --tsconfig ./tsconfig.json --test 'src/lib/server/*.test.ts' 'src/app/api/provider-events/**/*.test.ts'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@witnessops/ask-authority": "workspace:*",
    "@witnessops/catalog": "workspace:*",
    "@witnessops/config": "workspace:*",
    "@witnessops/content": "workspace:*",
    "@witnessops/proof": "workspace:*",
    "@witnessops/ui": "workspace:*",
    "framer-motion": "^12.36.0",
    "jose": "^6.2.2",
    "js-yaml": "^4.3.1",
    "lucide-react": "^1.7.0",
    "next": "15.5.21",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1",
    "standardwebhooks": "1.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.18",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
