{
  "realm": "academy",
  "enabled": true,
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "academy-app",
      "name": "Academy lesson server",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://academy.example.invalid/academy/auth/callback"
      ],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "https://academy.example.invalid/academy/learn/report-or-evidence"
      },
      "protocolMappers": [
        {
          "name": "academy-app-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "academy-app",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ]
}
