{
  "name": "@witnessops/app",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3020",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3020",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "NODE_ENV=test node --import ../witnessops-web/scripts/register-server-only-test-stub.mjs --import tsx --test 'src/**/*.test.ts'",
    "db:migrate": "node scripts/migrate.mjs",
    "test:db": "NODE_ENV=test node --import ../witnessops-web/scripts/register-server-only-test-stub.mjs --import tsx --test src/lib/db/database.integration.ts",
    "test:db:live": "NODE_ENV=test node --import ../witnessops-web/scripts/register-server-only-test-stub.mjs --import ../../tests/proofpack/live-classified/register-test-trust.mjs --import tsx --test src/lib/db/linux-live.integration.ts"
  },
  "dependencies": {
    "@witnessops/config": "workspace:*",
    "@witnessops/ui": "workspace:*",
    "@workos-inc/authkit-nextjs": "4.3.1",
    "@workos-inc/node": "10",
    "next": "15.5.24",
    "pg": "8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
