# Copy to .env.local (ignored). Never commit real values.
WORKOS_API_KEY=replace-with-workos-development-key
WORKOS_CLIENT_ID=replace-with-workos-staging-client-id
WORKOS_COOKIE_PASSWORD=replace-with-at-least-32-random-characters
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://127.0.0.1:3020/callback
# Do not set WORKOS_COOKIE_DOMAIN: app session cookies must be host-only.
WORKOS_COOKIE_SAMESITE=lax
WORKOS_COOKIE_MAX_AGE=604800
DATABASE_URL=postgresql://app_runtime:replace-me@127.0.0.1:55432/witnessops_app_dev
DATABASE_MIGRATION_URL=postgresql://app_migrator:replace-me@127.0.0.1:55432/witnessops_app_dev

# Put this variable in a SEPARATE ignored .env.test.local, not .env.local:
# TEST_DATABASE_URL=postgresql://app_test:replace-me@127.0.0.1:55432/witnessops_app_test
# Opt-in self-service staging ceiling (2–20 workspaces per creator).
# Leave unset to preserve invitation-only admission. No paid plan or trial.
# WITNESSOPS_FREE_WORKSPACE_LIMIT=3

# Report-link delivery is independent of invitation mail. Off by default.
WITNESSOPS_REPORT_EMAIL_ENABLED=0
# Set to 1 only after disabling open/click tracking in the selected mail provider.
# This flag records the deployment configuration; it does not change provider settings.
WITNESSOPS_REPORT_EMAIL_TRACKING_DISABLED=0
