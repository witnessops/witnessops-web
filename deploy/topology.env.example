# Copy these variable names into a private, ignored operator environment file.
# Only the generic production plane is public authority metadata. Exact host,
# instance, namespace, workload, Secret, storage, and mesh values stay private.
DEPLOY_SSH=deploy-host.private.example
PROD_TARGET_PROFILE=prod-aws-frankfurt
PROD_EXPECTED_HOSTNAME=deploy-host.private.example
PROD_EXPECTED_INSTANCE_ID=i-0123456789abcdef0
DEPLOY_NS=example-namespace
PROD_DEPLOY=example-prod-deployment
PROD_SERVICE=example-prod-service
DEV_DEPLOY=example-dev-deployment
APP_CONTAINER_NAME=example-app-container
BASE_ENV_SECRET=example-runtime-secret
ADMIN_OIDC_SECRET=example-identity-secret
# WITNESSOPS_ADMIN_ROLE is required in this Secret and must be Founder,
# Delegated Operator, or Administrator.
INTAKE_STORE_PVC=example-intake-pvc
INTAKE_EVENTS_PVC=example-events-pvc
MAIL_OUT_PVC=example-mail-pvc
MESH_BIND_HOST=192.0.2.10
MESH_BIND_PORT=3001
MESH_DEV_URL=http://192.0.2.10:3001
