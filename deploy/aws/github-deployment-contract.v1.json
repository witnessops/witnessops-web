      "staging_deployer_cannot_target_production_document_or_node",
      "production_deployer_cannot_target_staging_document_or_node",
      "untagged_or_wrongly_tagged_managed_node_denied",
      "mutable_image_input_rejected",
      "missing_or_failed_image_scan_policy_rejected",
      "arbitrary_command_input_rejected",
      "missing_or_mismatched_runtime_digest_fails_acceptance"
    ]
  }
