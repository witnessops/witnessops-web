# witnessops-web runtime environment (production / edge02)
#
# Copy this to the host at /srv/witnessops/env/witnessops-web.env, fill in real
# secret values, and chmod 600 (owner root, group witnessops). This file is the
# env_file referenced by deploy/docker-compose.yml.
#
# Keys below mirror the live edge02 runtime set. Directory values point at the
# in-container mount targets from docker-compose.yml (/data/*), NOT host paths.
#
# Never commit a filled-in copy of this file.

# --- Core ---
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# --- Public origin / verification ---
NEXT_PUBLIC_OS_SITE_URL=https://witnessops.com
WITNESSOPS_VERIFY_BASE_URL=https://witnessops.com

# --- Mail (Resend transactional; Proton handles human inboxes) ---
WITNESSOPS_MAIL_PROVIDER=resend
WITNESSOPS_RESEND_API_KEY=re_replace_me
# WITNESSOPS_RESEND_WEBHOOK_SECRET=whsec_replace_me
WITNESSOPS_TOKEN_FROM_EMAIL=engage@witnessops.com
WITNESSOPS_MAILBOX_ENGAGE=engage@witnessops.com
WITNESSOPS_MAILBOX_SUPPORT=support@witnessops.com
WITNESSOPS_MAILBOX_NOREPLY=noreply@witnessops.com
# Only set in file mail mode (non-production). Maps to the /data/mail-out mount.
# WITNESSOPS_MAIL_OUTPUT_DIR=/data/mail-out

# --- Tokens ---
WITNESSOPS_TOKEN_SIGNING_SECRET=replace-with-long-random-secret
WITNESSOPS_CLAIMANT_SESSION_SECRET=replace-with-long-random-secret
WITNESSOPS_TOKEN_TTL_MINUTES=30

# --- Persistent storage (in-container targets; host mounts in compose) ---
WITNESSOPS_INTAKE_STORE_DIR=/data/intake-store
WITNESSOPS_TOKEN_STORE_DIR=/data/intake-store
WITNESSOPS_INTAKE_EVENT_DIR=/data/intake-events
WITNESSOPS_TOKEN_AUDIT_DIR=/data/intake-events

# --- Optional: docs assistant (disable unless explicitly provisioned) ---
# WITNESSOPS_DOCS_ASSISTANT_ENABLED=false
# WITNESSOPS_DOCS_ASSISTANT_STAGE=staging
# WITNESSOPS_DOCS_ASSISTANT_MODEL=
# WITNESSOPS_DOCS_ASSISTANT_VECTOR_STORE_ID=
# OPENAI_API_KEY=

# --- Optional: control plane / governed exposure (leave unset to disable) ---
# CONTROL_PLANE_URL=
# CONTROL_PLANE_API_KEY=
# GES_SERVER_URL=
# GES_ASSESSMENT_KEY=

# --- Optional: admin routes (only if enabled) ---
# WITNESSOPS_ADMIN_SECRET=
# WITNESSOPS_ADMIN_KEY_HASH=
