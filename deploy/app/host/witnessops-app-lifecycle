#!/usr/bin/python3
"""Root-owned systemd helper. No force removal, pulls, or volume deletion."""
import fcntl
import json
import os
import pathlib
import re
import subprocess
import sys
from urllib.parse import urlsplit, parse_qs, unquote

NAME = 'witnessops-app'
LABEL = 'io.witnessops.service'
CONFIG = pathlib.Path('/etc/witnessops-app')
PODMAN = '/usr/bin/podman'
LOCK = '/run/witnessops-app-lifecycle/lock'


def log(event, **fields):
    print(json.dumps({'event': event, **fields}), flush=True)


def call(args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def podman_json(*args):
    return json.loads(subprocess.check_output([PODMAN, *args], text=True))


def identity(container, image):
    return (container['Name'].lstrip('/') == NAME
            and container['Config'].get('Labels', {}).get(LABEL) == 'app'
            and container['Image'].removeprefix('sha256:') == image.removeprefix('sha256:'))


def inventory():
    ids = subprocess.check_output([PODMAN, 'ps', '-aq'], text=True).split()
    if not ids:
        return []
    return [c for c in podman_json('container', 'inspect', *ids)
            if c['Name'].lstrip('/').startswith(NAME)
            or c['Config'].get('Labels', {}).get(LABEL) == 'app']


def inspect_expected(image):
    containers = inventory()
    log('inventory', candidates=len(containers), running=sum(c['State']['Running'] for c in containers))
    if len(containers) > 1 or any(not identity(c, image) for c in containers):
        raise RuntimeError('unexpected container identity or additional app container')
    return containers[0] if containers else None


def preflight(image):
    if not re.fullmatch(r'sha256:[0-9a-f]{64}', image):
        raise RuntimeError('immutable image ID required')
    approval = json.loads((CONFIG / 'image-security-approved').read_text())
    if approval.get('imageConfig') != image or approval.get('vulnerabilities') != 0 or approval.get('secrets') != 0:
        raise RuntimeError('image approval mismatch')
    actual = podman_json('image', 'inspect', image)[0]['Id']
    if actual.removeprefix('sha256:') != image.removeprefix('sha256:'):
        raise RuntimeError('local image identity mismatch')
    call(['/usr/local/sbin/witnessops-app-config-check'])
    values = dict(line.split('=', 1) for line in (CONFIG / 'runtime.env').read_text().splitlines()
                  if '=' in line and not line.startswith('#'))
    # libpq environment fields avoid putting a credential-bearing URI in argv.
    uri = urlsplit(values['DATABASE_URL'])
    query = parse_qs(uri.query)
    if uri.scheme not in ('postgres', 'postgresql') or not uri.username or not uri.path:
        raise RuntimeError('invalid runtime database configuration')
    env = {'PATH': '/usr/bin:/bin', 'PGDATABASE': unquote(uri.path.lstrip('/')),
           'PGUSER': unquote(uri.username), 'PGPASSWORD': unquote(uri.password or ''),
           'PGHOST': query.get('host', [uri.hostname or ''])[0],
           'PGPORT': str(uri.port or 5432), 'PGCONNECT_TIMEOUT': '5'}
    if 'sslmode' in query:
        env['PGSSLMODE'] = query['sslmode'][0]
    call(['/usr/bin/psql', '-X', '--no-password', '-tA', '-c', 'SELECT 1'], env=env,
         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=8)
    log('preflight_pass', image=image)


def run_args(image):
    return [PODMAN, '--runtime=/usr/sbin/runc', 'run', '--pull=never', '--name', NAME,
            '--label', LABEL + '=app', '--network=witnessops-app',
            '--publish=127.0.0.1:3020:3020', '--env=HOSTNAME=0.0.0.0',
            '--read-only', '--cap-drop=all', '--security-opt=no-new-privileges',
            '--user=1001:1001', '--memory=1g', '--cpus=1.5', '--pids-limit=128',
            '--env-file=/etc/witnessops-app/runtime.env',
            '--volume=/var/run/postgresql:/var/run/postgresql:ro',
            '--tmpfs=/tmp:rw,noexec,nosuid,size=64m',
            '--health-cmd=node -e \'fetch("http://127.0.0.1:3020/",{redirect:"manual"}).then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))\'',
            '--health-interval=30s', '--health-start-period=30s', image]


def start(image):
    # Held for the foreground runtime lifetime. Another helper cannot race cleanup/start.
    with open(LOCK, 'a', encoding='utf-8') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        preflight(image)
        previous = inspect_expected(image)
        if previous:
            state = previous['State']
            if state['Running'] or state.get('Paused') or state.get('Restarting'):
                raise RuntimeError('expected app container is already running; refusing duplicate')
            if state.get('Status') not in ('exited', 'stopped', 'created', 'configured'):
                raise RuntimeError('ambiguous container state; operator inspection required')
            # Recheck immediately before non-force removal. Podman itself rejects rm of a running container.
            current = podman_json('container', 'inspect', previous['Id'])[0]
            if not identity(current, image) or current['State']['Running']:
                raise RuntimeError('container changed during cleanup')
            call([PODMAN, 'rm', current['Id']], stdout=subprocess.DEVNULL)
            log('stale_removed', container=current['Id'], image=image)
        if inspect_expected(image) is not None:
            raise RuntimeError('container appeared before start')
        log('start', image=image, expected_running=1)
        result = subprocess.run(run_args(image), check=False)
        log('runtime_exit', exit_code=result.returncode)
        return result.returncode


def stop(image):
    # Does not acquire the start lock: systemd calls stop while start owns it.
    if not re.fullmatch(r'sha256:[0-9a-f]{64}', image):
        raise RuntimeError('immutable image ID required')
    current = inspect_expected(image)
    if current:
        if current['State']['Running']:
            call([PODMAN, 'stop', '--time=45', current['Id']], stdout=subprocess.DEVNULL)
        log('stop', container=current['Id'], image=image)
        # Retain exited container/logs; next start performs guarded cleanup.
        remaining = podman_json('container', 'inspect', current['Id'])[0]
        if remaining['State']['Running']:
            raise RuntimeError('container remained running after stop')
    log('stopped', running=0)
    return 0


def main():
    try:
        if os.geteuid() != 0 or len(sys.argv) != 3 or sys.argv[1] not in ('start', 'stop'):
            raise RuntimeError('root and start/stop with immutable image ID required')
        return (start if sys.argv[1] == 'start' else stop)(sys.argv[2])
    except Exception as error:
        # Exceptions can contain argv or environment details. Emit class only.
        log('lifecycle_failed', failure_class=type(error).__name__)
        return 1


if __name__ == '__main__':
    sys.exit(main())
