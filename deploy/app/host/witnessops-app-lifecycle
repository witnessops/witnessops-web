#!/usr/bin/python3
"""Root-owned systemd helper. No force removal, pulls, or volume deletion.

Operator copy, before the next start and only as a separate deploy action:
copy the CI artifact files identity.json and image.sha256 unchanged from
app-image-candidate into /etc/witnessops-app/ci-candidate/. The approval file
image-security-approved must name the same on-host image ID (identity.json
image_digest or config_digest) and the archive hex from image.sha256. This
helper does not sign that manifest and does not re-hash image.tar.

A missing or mismatched candidate raises CandidateMismatch and main exits 78
before any container is removed or started. The unit lists 78 in
RestartPreventExitStatus, so systemd does not retry that permanent failure.
Other failures still use Restart=on-failure, RestartSec=15, and
StartLimitBurst=10 inside StartLimitIntervalSec=300.
"""
import fcntl
import json
import os
import pathlib
import re
import stat
import subprocess
import sys
from urllib.parse import urlsplit, parse_qs, unquote

NAME = 'witnessops-app'
LABEL = 'io.witnessops.service'
CONFIG = pathlib.Path('/etc/witnessops-app')
PODMAN = '/usr/bin/podman'
LOCK = '/run/witnessops-app-lifecycle/lock'
MANIFEST_LIMIT = 8192
DIGEST = re.compile(r'sha256:[0-9a-f]{64}\Z')
CANDIDATE_REASONS = ('missing_manifest', 'invalid_manifest', 'approval_mismatch', 'digest_mismatch')


class CandidateMismatch(RuntimeError):
    """Permanent candidate/approval failure. Exit 78; do not restart."""

    def __init__(self, reason):
        self.reason = reason if reason in CANDIDATE_REASONS else 'invalid_manifest'
        super().__init__(self.reason)


def read_manifest(path, missing):
    try:
        info = path.lstat()
    except FileNotFoundError:
        raise CandidateMismatch(missing) from None
    except OSError:
        raise CandidateMismatch('invalid_manifest') from None
    if stat.S_ISLNK(info.st_mode) or not stat.S_ISREG(info.st_mode) or not 0 < info.st_size <= MANIFEST_LIMIT:
        raise CandidateMismatch('invalid_manifest' if missing == 'missing_manifest' else missing)
    try:
        return path.read_text(encoding='utf-8')
    except (OSError, UnicodeError):
        raise CandidateMismatch('invalid_manifest' if missing == 'missing_manifest' else missing) from None


def recorded_candidate():
    """Digests from the operator-copied CI files, not from a signature."""
    root = CONFIG / 'ci-candidate'
    try:
        identity = json.loads(read_manifest(root / 'identity.json', 'missing_manifest'))
    except CandidateMismatch:
        raise
    except json.JSONDecodeError:
        raise CandidateMismatch('invalid_manifest') from None
    archive_text = read_manifest(root / 'image.sha256', 'missing_manifest')
    if not isinstance(identity, dict):
        raise CandidateMismatch('invalid_manifest')
    image_digest = identity.get('image_digest')
    config_digest = identity.get('config_digest')
    if not isinstance(image_digest, str) or not DIGEST.fullmatch(image_digest):
        raise CandidateMismatch('invalid_manifest')
    if not isinstance(config_digest, str) or not DIGEST.fullmatch(config_digest):
        raise CandidateMismatch('invalid_manifest')
    line = archive_text[:-1] if archive_text.endswith('\n') else archive_text
    match = re.fullmatch(r'([0-9a-f]{64})  image\.tar', line)
    if not match:
        raise CandidateMismatch('invalid_manifest')
    return image_digest, config_digest, match.group(1)


def bind_candidate(image):
    image_digest, config_digest, archive = recorded_candidate()
    try:
        approval = json.loads(read_manifest(CONFIG / 'image-security-approved', 'approval_mismatch'))
    except CandidateMismatch:
        raise
    except json.JSONDecodeError:
        raise CandidateMismatch('approval_mismatch') from None
    if (not isinstance(approval, dict) or approval.get('imageConfig') != image
            or approval.get('vulnerabilities') != 0 or approval.get('secrets') != 0):
        raise CandidateMismatch('approval_mismatch')
    # The engine image ID is one of the two CI identity digests. The archive
    # checksum is a different value and must be copied through unchanged.
    if image not in (image_digest, config_digest) or approval.get('archiveSha256') != archive:
        raise CandidateMismatch('digest_mismatch')


def log(event, **fields):
    print(json.dumps({'event': event, **fields}), flush=True)


def call(args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def podman_json(*args):
    return json.loads(subprocess.check_output([PODMAN, *args], text=True))


def identity(container, image):
    return (container['Name'].lstrip('/') == NAME
            and container['Config'].get('Labels', {}).get(LABEL) == 'app'
            and container['Image'].removeprefix('sha256:') == image.removeprefix('sha256:'))


def inventory():
    ids = subprocess.check_output([PODMAN, 'ps', '-aq'], text=True).split()
    if not ids:
        return []
    return [c for c in podman_json('container', 'inspect', *ids)
            if c['Name'].lstrip('/').startswith(NAME)
            or c['Config'].get('Labels', {}).get(LABEL) == 'app']


def inspect_expected(image):
    containers = inventory()
    log('inventory', candidates=len(containers), running=sum(c['State']['Running'] for c in containers))
    if len(containers) > 1 or any(not identity(c, image) for c in containers):
        raise RuntimeError('unexpected container identity or additional app container')
    return containers[0] if containers else None


def preflight(image):
    if not re.fullmatch(r'sha256:[0-9a-f]{64}', image):
        raise RuntimeError('immutable image ID required')
    bind_candidate(image)
    actual = podman_json('image', 'inspect', image)[0]['Id']
    if actual.removeprefix('sha256:') != image.removeprefix('sha256:'):
        raise RuntimeError('local image identity mismatch')
    call(['/usr/local/sbin/witnessops-app-config-check'])
    values = dict(line.split('=', 1) for line in (CONFIG / 'runtime.env').read_text().splitlines()
                  if '=' in line and not line.startswith('#'))
    # libpq environment fields avoid putting a credential-bearing URI in argv.
    uri = urlsplit(values['DATABASE_URL'])
    query = parse_qs(uri.query)
    if uri.scheme not in ('postgres', 'postgresql') or not uri.username or not uri.path:
        raise RuntimeError('invalid runtime database configuration')
    env = {'PATH': '/usr/bin:/bin', 'PGDATABASE': unquote(uri.path.lstrip('/')),
           'PGUSER': unquote(uri.username), 'PGPASSWORD': unquote(uri.password or ''),
           'PGHOST': query.get('host', [uri.hostname or ''])[0],
           'PGPORT': str(uri.port or 5432), 'PGCONNECT_TIMEOUT': '5'}
    if 'sslmode' in query:
        env['PGSSLMODE'] = query['sslmode'][0]
    call(['/usr/bin/psql', '-X', '--no-password', '-tA', '-c', 'SELECT 1'], env=env,
         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=8)
    # Exact "1" matches the app gate. Any other value leaves the key unmounted.
    enabled = values.get('WITNESSOPS_FINALIZER_ENABLED') == '1'
    if enabled:
        # The same mounts and image identity are checked before any existing container is removed.
        call([*run_args(image, readiness=True, finalizer=True)], stdout=subprocess.DEVNULL, timeout=30)
    else:
        log('finalizer_disabled')
    log('preflight_pass', image=image)
    return enabled


def run_args(image, readiness=False, finalizer=False):
    if readiness and not finalizer:
        raise RuntimeError('finalizer readiness requires WITNESSOPS_FINALIZER_ENABLED=1')
    args = [PODMAN, '--runtime=/usr/sbin/runc', 'run', '--pull=never', '--name', NAME + ('-readiness' if readiness else ''),
            '--label', LABEL + '=app', '--network=witnessops-app',
            '--publish=127.0.0.1:3020:3020', '--env=HOSTNAME=0.0.0.0',
            '--read-only', '--cap-drop=all', '--security-opt=no-new-privileges',
            '--user=1001:1001', '--memory=1g', '--cpus=1.5', '--pids-limit=128',
            '--env-file=/etc/witnessops-app/runtime.env',
            '--volume=/var/run/postgresql:/var/run/postgresql:ro']
    if finalizer:
        args += ['--mount=type=bind,source=/var/lib/witnessops-finalizer,destination=/var/lib/witnessops-finalizer',
                 '--mount=type=bind,source=/etc/witnessops-app/finalizer-key,destination=/run/witnessops-finalizer/key,ro=true',
                 '--env=WITNESSOPS_FINALIZER_PYTHON=/opt/witnessops/finalizer/venv/bin/python',
                 '--env=WITNESSOPS_FINALIZER_DIRECTORY=/var/lib/witnessops-finalizer',
                 '--env=WITNESSOPS_FINALIZER_KEY=/run/witnessops-finalizer/key']
    args += ['--tmpfs=/tmp:rw,noexec,nosuid,size=64m',
            '--health-cmd=node -e \'fetch("http://127.0.0.1:3020/",{redirect:"manual"}).then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))\'',
            '--health-interval=30s', '--health-start-period=30s']
    if readiness:
        # No networking or signing; cleanup only this disposable readiness container.
        args = [a for a in args if not a.startswith(('--network=', '--publish='))]
        args += ['--network=none', '--rm', '--entrypoint=/opt/witnessops/finalizer/venv/bin/python', image,
                 '-I', '/opt/witnessops/finalizer-readiness.py']
    else:
        args += [image]
    return args


def start(image):
    # Held for the foreground runtime lifetime. Another helper cannot race cleanup/start.
    with open(LOCK, 'a', encoding='utf-8') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        finalizer = preflight(image) is True
        previous = inspect_expected(image)
        if previous:
            state = previous['State']
            if state['Running'] or state.get('Paused') or state.get('Restarting'):
                raise RuntimeError('expected app container is already running; refusing duplicate')
            if state.get('Status') not in ('exited', 'stopped', 'created', 'configured'):
                raise RuntimeError('ambiguous container state; operator inspection required')
            # Recheck immediately before non-force removal. Podman itself rejects rm of a running container.
            current = podman_json('container', 'inspect', previous['Id'])[0]
            if not identity(current, image) or current['State']['Running']:
                raise RuntimeError('container changed during cleanup')
            call([PODMAN, 'rm', current['Id']], stdout=subprocess.DEVNULL)
            log('stale_removed', container=current['Id'], image=image)
        if inspect_expected(image) is not None:
            raise RuntimeError('container appeared before start')
        log('start', image=image, expected_running=1)
        result = subprocess.run(run_args(image, finalizer=finalizer), check=False)
        log('runtime_exit', exit_code=result.returncode)
        return result.returncode


def stop(image):
    # Does not acquire the start lock: systemd calls stop while start owns it.
    if not re.fullmatch(r'sha256:[0-9a-f]{64}', image):
        raise RuntimeError('immutable image ID required')
    current = inspect_expected(image)
    if current:
        if current['State']['Running']:
            call([PODMAN, 'stop', '--time=45', current['Id']], stdout=subprocess.DEVNULL)
        log('stop', container=current['Id'], image=image)
        # Retain exited container/logs; next start performs guarded cleanup.
        remaining = podman_json('container', 'inspect', current['Id'])[0]
        if remaining['State']['Running']:
            raise RuntimeError('container remained running after stop')
    log('stopped', running=0)
    return 0


def main():
    try:
        if os.geteuid() != 0 or len(sys.argv) != 3 or sys.argv[1] not in ('start', 'stop'):
            raise RuntimeError('root and start/stop with immutable image ID required')
        return (start if sys.argv[1] == 'start' else stop)(sys.argv[2])
    except CandidateMismatch as error:
        # Reason is a fixed code. Do not echo manifest or approval bytes.
        log('candidate_mismatch', reason=error.reason, exit_code=78)
        return 78
    except Exception as error:
        # Exceptions can contain argv or environment details. Emit class only.
        log('lifecycle_failed', failure_class=type(error).__name__)
        return 1


if __name__ == '__main__':
    sys.exit(main())
