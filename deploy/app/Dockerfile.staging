# Separate, production-optimized synthetic staging artifact. The standard app
# Dockerfile and its default production refusal are unchanged. Build arguments
# are reviewed non-secret bindings; never pass passwords, API keys or DB URLs.
FROM node:22.23.2-alpine3.24@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@9.15.4 --activate
COPY . .
ARG STAGING_ORIGIN
ARG STAGING_WORKOS_CLIENT_ID
ARG STAGING_DATABASE_SHA256
ENV NODE_ENV=production WITNESSOPS_BUILD_PROFILE=aasr-staging \
    WITNESSOPS_STAGING_BUILD_ORIGIN=$STAGING_ORIGIN \
    WITNESSOPS_STAGING_BUILD_WORKOS_CLIENT_ID=$STAGING_WORKOS_CLIENT_ID \
    WITNESSOPS_STAGING_BUILD_DATABASE_SHA256=$STAGING_DATABASE_SHA256 \
    NEXT_PUBLIC_WORKOS_REDIRECT_URI=$STAGING_ORIGIN/callback
RUN pnpm install --frozen-lockfile --prod=false && pnpm --filter @witnessops/app build \
    && node -e "require('node:fs').writeFileSync('/app/aasr-staging-build.json', JSON.stringify(require('./apps/witnessops-app/src/lib/aasr-staging/build-profile').aasrBuildProfile()))"

FROM node:22.23.2-alpine3.24@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32
# The pinned base predates the Alpine musl and zlib security fixes.
RUN apk add --no-cache --upgrade libcrypto3=3.5.9-r0 libssl3=3.5.9-r0 \
      musl=1.2.6-r3 musl-utils=1.2.6-r3 zlib=1.3.2-r1 \
    && rm -rf /usr/local/lib/node_modules /opt/yarn-v1.22.22 \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack \
      /usr/local/bin/yarn /usr/local/bin/yarnpkg /usr/local/bin/docker-entrypoint.sh \
    && addgroup -g 1001 -S nodejs && adduser -S -u 1001 -G nodejs nextjs
ARG SOURCE_COMMIT
ARG SOURCE_DIRTY
ARG BUILD_INPUT_SHA256
ARG STAGING_ORIGIN
ARG STAGING_WORKOS_CLIENT_ID
ARG STAGING_DATABASE_SHA256
LABEL org.opencontainers.image.revision=$SOURCE_COMMIT \
      com.witnessops.source-dirty=$SOURCE_DIRTY \
      com.witnessops.build-input-sha256=$BUILD_INPUT_SHA256 \
      com.witnessops.build-profile=aasr-staging \
      com.witnessops.staging-origin=$STAGING_ORIGIN \
      com.witnessops.staging-workos-client=$STAGING_WORKOS_CLIENT_ID \
      com.witnessops.staging-database-sha256=$STAGING_DATABASE_SHA256
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3020 \
    NEXT_PUBLIC_WORKOS_REDIRECT_URI=$STAGING_ORIGIN/callback
WORKDIR /app
COPY --from=builder /app/apps/witnessops-app/.next/standalone ./
COPY --from=builder /app/apps/witnessops-app/.next/static ./apps/witnessops-app/.next/static
COPY --from=builder /app/apps/witnessops-app/public ./apps/witnessops-app/public
COPY --from=builder /app/aasr-staging-build.json ./aasr-staging-build.json
COPY apps/witnessops-app/src/lib/aasr-staging/build-profile.js apps/witnessops-app/src/lib/aasr-staging/runtime-policy.js ./staging/
COPY deploy/app/staging-entrypoint.cjs ./staging/entrypoint.cjs
USER nextjs
ENTRYPOINT ["node", "staging/entrypoint.cjs"]
