# Source-only exact-host block. Merge into a freshly captured full active
# Caddyfile only after a separate production GO and full-config validation.
# The static release tool stages this root; it does not edit or reload Caddy.
# /mcp and the path-suffixed OAuth protected-resource metadata path reverse-proxy
# to the loopback Academy MCP server. The resource identifier is /mcp, so RFC 9728
# uses /.well-known/oauth-protected-resource/mcp. The origin-level well-known path
# is a different resource and is not routed. These paths are not part of the static release.
academy.witnessops.com {
	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy 127.0.0.1:18500 {
			flush_interval -1
		}
	}

	@prm path /.well-known/oauth-protected-resource/mcp
	handle @prm {
		reverse_proxy 127.0.0.1:18500
	}

	handle {
		root * /srv/witnessops-academy/current

		header {
			Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
			X-Content-Type-Options "nosniff"
			Referrer-Policy "strict-origin-when-cross-origin"
			Cache-Control "no-store"
		}

		@write not method GET HEAD
		header @write Allow "GET, HEAD"
		respond @write "Method not allowed" 405

		file_server {
			index index.html
			hide .*
		}
	}
}
